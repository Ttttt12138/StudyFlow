STUDYFLOW_MODE=mock
OPENAI_API_KEY=
OPENAI_BASE_URL=https://ai.psu.blue/v1
OPENAI_MODEL=openai/gpt-6-luna
TYPESAFE_API_KEY=
TYPESAFE_DEFAULT_MODEL=jev-latest
# Load these variables explicitly in your shell or deployment platform.
# The CLI does not automatically load .env; use --env-file .env explicitly.

# C-owned Gemini OCR configuration. Django/worker load this module's .env automatically.
# OCR is independent of STUDYFLOW_MODE; enabling it makes real API requests.
STUDYFLOW_OCR_ENABLED=false
GEMINI_API_KEY=
STUDYFLOW_OCR_MODEL=
# Optional comma-separated models tried after transient 503/429/timeout failures.
STUDYFLOW_OCR_FALLBACK_MODELS=
# Total requests per OCR task across primary and fallbacks (1-5); 1 disables retry.
STUDYFLOW_OCR_MAX_ATTEMPTS=3
STUDYFLOW_OCR_TIMEOUT=60
# Operator attestations, not automatic identity or compliance verification.
STUDYFLOW_OCR_PAID_SERVICE_CONFIRMED=false
STUDYFLOW_OCR_ADULT_ONLY_CONFIRMED=false
STUDYFLOW_DOCUMENT_RETENTION_DAYS=30
STUDYFLOW_OCR_REQUESTS_PER_HOUR=10

DJANGO_SECRET_KEY=replace-with-a-random-local-secret
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
# Production hardening (docs/permissions.md §7); leave false for local HTTP.
DJANGO_SECURE=false
# DJANGO_HSTS_SECONDS=3600
# DJANGO_SECURE_PROXY_SSL_HEADER=false
# DJANGO_NUM_PROXIES=0  # trusted reverse-proxy hops for per-IP rate limits
# DJANGO_CSRF_TRUSTED_ORIGINS=https://studyflow.example.com
# Rate limits, e.g. STUDYFLOW_THROTTLE_STEP_UP=10/hour (scopes: USER, ANON, AUTH, STEP_UP, MONEY, SPONSOR).
DB_NAME=studyflow
DB_USER=studyflow
DB_PASSWORD=local-simulation-only
DB_HOST=127.0.0.1
DB_PORT=55433
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
# Email OTP. Console output is safe for local development; use SMTP in deployed environments.
DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL="StudyFlow <no-reply@studyflow.local>"
STUDYFLOW_OTP_TTL_SECONDS=600
STUDYFLOW_OTP_RESEND_SECONDS=60
STUDYFLOW_OTP_MAX_ATTEMPTS=5
STUDYFLOW_READINESS_ENABLED=false
STUDYFLOW_CONSUMPTION_ENABLED=false
STUDYFLOW_MODE=mock
# live requires OPENAI_API_KEY, TYPESAFE_API_KEY and the existing C model settings.

# Gemini OCR settings belong to C: studyflow-ai/.env (see studyflow-ai/.env.example).

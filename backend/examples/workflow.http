# VS Code REST Client syntax. Copy tokens from the private .demo-credentials.json.
# Do not commit tokens. Use a fresh Idempotency-Key for each NEW command;
# repeat the same key and body for a retry.
@base = http://127.0.0.1:8000/api/v2
@studentToken = REPLACE_LOCALLY
@operatorToken = REPLACE_LOCALLY
@loanId = SEE_examples_demo-ids.json
@appId = REPLACE_FROM_APPLICATION_RESPONSE
@accountId = REPLACE_FROM_DISBURSEMENT_RESPONSE
@planId = REPLACE_FROM_PLAN_RESPONSE
@beneficiaryId = SEE_examples_demo-ids.json
@paymentId = REPLACE_FROM_PAYMENT_RESPONSE
@scenarioId = REPLACE_FROM_CURRENT_SCENARIO_RESPONSE
@version = 1

### List seeded budgets
GET {{base}}/scenarios/
Authorization: Token {{studentToken}}

### Create application (student)
POST {{base}}/applications/
Authorization: Token {{studentToken}}
Idempotency-Key: demo-application-1
Content-Type: application/json

{"quote_id":"{{loanId}}"}

### Submit application (student)
POST {{base}}/applications/{{appId}}/action/
Authorization: Token {{studentToken}}
Idempotency-Key: demo-submit-application-1
Content-Type: application/json

{"action":"submit","expected_version":1}

### Supply all repayment months (student; expected_version=0 for the first profile)
POST {{base}}/affordability-profile/
Authorization: Token {{studentToken}}
Idempotency-Key: demo-profile-1
Content-Type: application/json

{
  "expected_version": 0,
  "months": [

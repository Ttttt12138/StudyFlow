{
  "Draft": {
    "$defs": {
      "Cost": {
        "additionalProperties": false,
        "properties": {
          "cost_id": {
            "maxLength": 100,
            "minLength": 1,
            "pattern": "^[a-zA-Z0-9_-]+$",
            "title": "Cost Id",
            "type": "string"
          },
          "component": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Component"
          },
          "category": {
            "enum": [
              "tuition",
              "housing",
              "deposit",
              "food",
              "transport",
              "communications",
              "subscription",
              "utilities",
              "insurance",
              "visa",
              "travel",
              "settlement",
              "reserve"
            ],
            "title": "Category",
            "type": "string"
          },
          "currency": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Currency"
          },
          "amount": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Amount"
          },
          "lower": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Lower"
          },
          "upper": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Upper"
          },
          "period": {
            "anyOf": [
              {
                "enum": [
                  "once",
                  "monthly",
                  "semester",
                  "yearly"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Period"
          },
          "due_date": {
            "anyOf": [
              {
                "format": "date",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Due Date"
          },
          "year": {
            "anyOf": [
              {
                "maximum": 2200,
                "minimum": 1900,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Year"
          },
          "campus": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Campus"
          },
          "paid": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Paid"
          },
          "refundable": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Refundable"
          },
          "invoice_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Invoice Id"
          },
          "applicability": {
            "default": "APPLICABLE",
            "enum": [
              "APPLICABLE",
              "NOT_APPLICABLE"
            ],
            "title": "Applicability",
            "type": "string"
          },
          "applicability_reason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Applicability Reason"
          },
          "confidence_type": {
            "default": "UNCONFIRMED",
            "enum": [
              "VERIFIED",
              "INFERRED",
              "UNCONFIRMED"
            ],
            "title": "Confidence Type",
            "type": "string"
          },
          "verification_reference": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Verification Reference"
          },
          "evidence": {
            "items": {
              "$ref": "#/$defs/Evidence"
            },
            "title": "Evidence",
            "type": "array"
          },
          "source_refs": {
            "items": {
              "type": "string"
            },
            "title": "Source Refs",
            "type": "array"
          },
          "locked": {
            "default": false,
            "title": "Locked",
            "type": "boolean"
          },
          "observed_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Observed At"
          },
          "verified_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Verified At"
          },
          "planned_overrides": {
            "items": {
              "$ref": "#/$defs/PlannedOverride"
            },
            "maxItems": 24,
            "title": "Planned Overrides",
            "type": "array"
          },
          "valid_until": {
            "anyOf": [
              {
                "format": "date",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Valid Until"
          },
          "confidence": {
            "anyOf": [
              {
                "maximum": 1,
                "minimum": 0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Confidence"
          },
          "synthetic": {
            "default": false,
            "title": "Synthetic",
            "type": "boolean"
          },
          "conflict": {
            "default": false,
            "title": "Conflict",
            "type": "boolean"
          },
          "alternatives": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "title": "Alternatives",
            "type": "array"
          },
          "issuer": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Issuer"
          },
          "beneficiary_id": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Beneficiary Id"
          },
          "fx_quote_id": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Fx Quote Id"
          }
        },
        "required": [
          "cost_id",
          "category"
        ],
        "title": "Cost",
        "type": "object"
      },
      "Evidence": {
        "additionalProperties": false,
        "properties": {
          "source_id": {
            "title": "Source Id",
            "type": "string"
          },
          "field": {
            "title": "Field",
            "type": "string"
          },
          "quote": {
            "title": "Quote",
            "type": "string"
          },
          "locator": {
            "title": "Locator",
            "type": "string"
          }
        },
        "required": [
          "source_id",
          "field",
          "quote",
          "locator"
        ],
        "title": "Evidence",
        "type": "object"
      },
      "PlannedOverride": {
        "additionalProperties": false,
        "properties": {
          "effective_on": {
            "format": "date",
            "title": "Effective On",
            "type": "string"
          },
          "amount": {
            "anyOf": [
              {
                "maximum": 99999999999999.98,
                "type": "number"
              },
              {
                "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
                "type": "string"
              }
            ],
            "decimal_places": 2,
            "ge": 0,
            "max_digits": 18,
            "title": "Amount"
          }
        },
        "required": [
          "effective_on",
          "amount"
        ],
        "title": "PlannedOverride",
        "type": "object"
      },
      "Profile": {
        "additionalProperties": false,
        "properties": {
          "school": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "School"
          },
          "campus": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Campus"
          },
          "country": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Country"
          },
          "program": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Program"
          },
          "student_type": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Student Type"
          },
          "start_date": {
            "anyOf": [
              {
                "format": "date",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Start Date"
          },
          "end_date": {
            "anyOf": [
              {
                "format": "date",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "End Date"
          },
          "evidence": {
            "items": {
              "$ref": "#/$defs/Evidence"
            },
            "title": "Evidence",
            "type": "array"
          },
          "city": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "City"
          },
          "semester": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Semester"
          },
          "lifestyle_profile": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Lifestyle Profile"
          }
        },
        "title": "Profile",
        "type": "object"
      }
    },
    "additionalProperties": false,
    "properties": {
      "profile": {
        "$ref": "#/$defs/Profile"
      },
      "costs": {
        "items": {
          "$ref": "#/$defs/Cost"
        },
        "maxItems": 100,
        "title": "Costs",
        "type": "array"
      },
      "reserve": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Reserve"
      },
      "required_categories": {
        "items": {
          "type": "string"
        },
        "title": "Required Categories",
        "type": "array"
      }
    },
    "required": [
      "profile",
      "costs"
    ],
    "title": "Draft",
    "type": "object"
  },
  "FundingAction": {
    "$defs": {
      "PaymentPart": {
        "additionalProperties": false,
        "properties": {
          "date": {
            "format": "date",
            "title": "Date",
            "type": "string"
          },
          "amount": {
            "title": "Amount",
            "type": "string"
          }
        },
        "required": [
          "date",
          "amount"
        ],
        "title": "PaymentPart",
        "type": "object"
      }
    },
    "additionalProperties": false,
    "properties": {
      "kind": {
        "enum": [
          "installment",
          "reduce_spending"
        ],
        "title": "Kind",
        "type": "string"
      },
      "cost_id": {
        "title": "Cost Id",
        "type": "string"
      },
      "amount": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Amount"
      },
      "payments": {
        "items": {
          "$ref": "#/$defs/PaymentPart"
        },
        "maxItems": 60,
        "title": "Payments",
        "type": "array"
      },
      "evidence": {
        "maxLength": 2000,
        "minLength": 1,
        "title": "Evidence",
        "type": "string"
      }
    },
    "required": [
      "kind",
      "cost_id",
      "evidence"
    ],
    "title": "FundingAction",
    "type": "object"
  },
  "Allocation": {
    "additionalProperties": false,
    "properties": {
      "source_id": {
        "format": "uuid",
        "title": "Source Id",
        "type": "string"
      },
      "amount": {
        "title": "Amount",
        "type": "string"
      },
      "fx_quote_id": {
        "anyOf": [
          {
            "format": "uuid",
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Fx Quote Id"
      }
    },
    "required": [
      "source_id",
      "amount"
    ],
    "title": "Allocation",
    "type": "object"
  }
}

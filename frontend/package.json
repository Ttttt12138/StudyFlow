{
  "name": "studyflow-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run && playwright test --project=mocked",
    "test:unit": "vitest run",
    "test:e2e": "playwright test --project=mocked",
    "test:integration": "playwright test --project=integration",
    "test:wallet-integration": "playwright test --project=integration integration/wallet",
    "test:agent-integration": "playwright test --project=integration integration/agent"
  },
  "dependencies": {
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@fontsource/chakra-petch": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "postprocessing": "^6.39.5",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@fontsource/instrument-serif": "^5.3.0",
    "@playwright/test": "1.63.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.180.0",
    "opentype.js": "^1.3.4",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "4.1.11"
  },
  "engines": {
    "node": ">=22"
  }
}

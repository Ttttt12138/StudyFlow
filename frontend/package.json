{
  "name": "studyflow-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run && playwright test --project=mocked",
    "test:unit": "vitest run",
    "test:e2e": "playwright test --project=mocked",
    "test:integration": "playwright test --project=integration integration/journey",
    "test:wallet-integration": "playwright test --project=integration integration/wallet"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "4.1.11"
  },
  "engines": {
    "node": ">=22"
  }
}

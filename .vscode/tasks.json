{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Django check",
      "type": "process",
      "command": "${workspaceFolder}\\studyFlow\\Scripts\\python.exe",
      "args": [
        "manage.py",
        "check"
      ],
      "problemMatcher": [],
      "options": {
        "cwd": "${workspaceFolder}/backend"
      }
    },
    {
      "label": "Tests (isolated SQLite)",
      "type": "process",
      "command": "${workspaceFolder}\\studyFlow\\Scripts\\python.exe",
      "args": [
        "manage.py",
        "test",
        "--settings=config.test_settings"
      ],
      "problemMatcher": [],
      "group": "test",
      "options": {
        "cwd": "${workspaceFolder}/backend"
      }
    }
  ]
}

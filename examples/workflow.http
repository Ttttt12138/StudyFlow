# VS Code REST Client syntax. Copy tokens from the private .demo-credentials.json.
# Do not commit tokens. Use a fresh Idempotency-Key for each NEW command;
# repeat the same key and body for a retry.
@base = http://127.0.0.1:8000/api/v2
@studentToken = REPLACE_LOCALLY
@operatorToken = REPLACE_LOCALLY
@loanId = SEE_examples_demo-ids.json
@appId = REPLACE_FROM_APPLICATION_RESPONSE
@disbursementId = REPLACE_FROM_DISBURSEMENTS_LIST
@planId = REPLACE_FROM_PLAN_RESPONSE
@beneficiaryId = SEE_examples_demo-ids.json
@paymentId = REPLACE_FROM_PAYMENT_RESPONSE
@scenarioId = REPLACE_FROM_CURRENT_SCENARIO_RESPONSE
@version = 1

### List seeded budgets
GET {{base}}/scenarios/
Authorization: Token {{studentToken}}

### Create application (student)
POST {{base}}/applications/
Authorization: Token {{studentToken}}
Idempotency-Key: demo-application-1
Content-Type: application/json

{"loan_id":"{{loanId}}"}

### Submit application (student)
POST {{base}}/applications/{{appId}}/action/
Authorization: Token {{studentToken}}
Idempotency-Key: demo-submit-application-1
Content-Type: application/json

{"action":"submit"}

### Begin controlled mock review (operator)
POST {{base}}/applications/{{appId}}/decision/
Authorization: Token {{operatorToken}}
Idempotency-Key: demo-review-1
Content-Type: application/json

{"action":"review","reason":"Explicit mock review"}

### Mock approval (operator) -- does NOT credit the wallet
POST {{base}}/applications/{{appId}}/decision/
Authorization: Token {{operatorToken}}
Idempotency-Key: demo-approve-1
Content-Type: application/json

{"action":"approve","reason":"Demo approval only"}

### Inspect scheduled disbursement (student)
GET {{base}}/disbursements/
Authorization: Token {{studentToken}}

### Process (operator)
POST {{base}}/disbursements/{{disbursementId}}/action/
Authorization: Token {{operatorToken}}
Idempotency-Key: demo-process-disbursement-1
Content-Type: application/json

{"action":"process"}

### Settle once (operator)
POST {{base}}/disbursements/{{disbursementId}}/action/
Authorization: Token {{operatorToken}}
Idempotency-Key: demo-settle-disbursement-1
Content-Type: application/json

{"action":"settle"}

### Read NEW state version after settlement
GET {{base}}/state/
Authorization: Token {{studentToken}}

### Recalculate scenario against the new version (update @version above)
POST {{base}}/scenarios/
Authorization: Token {{studentToken}}
Idempotency-Key: demo-post-funding-scenario-1
Content-Type: application/json

{"state_version":{{version}},"kind":"expected","end_date":"2026-10-31"}

### New funding plan -- funds now appear in state, so do not add them again
POST {{base}}/funding-plans/
Authorization: Token {{studentToken}}
Idempotency-Key: demo-post-funding-plan-1
Content-Type: application/json

{"scenario_id":"{{scenarioId}}","allocations":[]}

# The seed already binds the expense to this mock-verified beneficiary.
# For a different beneficiary, confirm beneficiary_id on the expense using POST state/,
# then create a NEW scenario and funding plan against that version.

### Create tuition payment
POST {{base}}/payments/
Authorization: Token {{studentToken}}
Idempotency-Key: demo-tuition-1
Content-Type: application/json

{"plan_id":"{{planId}}","beneficiary_id":"{{beneficiaryId}}","event_id":"tuition"}

### Student authorization bound to exact state, plan, beneficiary and amount
POST {{base}}/payments/{{paymentId}}/authorize/
Authorization: Token {{studentToken}}
Idempotency-Key: demo-authorize-tuition-1
Content-Type: application/json

{"state_version":{{version}},"expires_in_seconds":900}

### Submit -- reserves funds; does not report settlement
POST {{base}}/payments/{{paymentId}}/submit/
Authorization: Token {{studentToken}}
Idempotency-Key: demo-submit-tuition-1
Content-Type: application/json

{}

### Controlled mock settlement callback
POST {{base}}/payments/{{paymentId}}/adapter-event/
Authorization: Token {{operatorToken}}
Idempotency-Key: demo-settle-tuition-1
Content-Type: application/json

{"outcome":"settled"}

### Reconcile receipt against task/expense reference
POST {{base}}/payments/{{paymentId}}/reconcile/
Authorization: Token {{studentToken}}
Idempotency-Key: demo-reconcile-tuition-1
Content-Type: application/json

{}

### Inspect immutable demo ledger
GET {{base}}/ledger/
Authorization: Token {{studentToken}}
